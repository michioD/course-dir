\frametitle{Assignment 7: Pruning Algorithm}
\textbf{Methodology:} Greedy Hill-Climbing using \texttt{allPruned} and \texttt{check}.

    \scalebox{0.75}{
    \begin{minipage}{1.2\textwidth}
    \begin{algorithm}[H]
    \caption{Reduced Error Pruning}
    \begin{algorithmic}[1]
    \Procedure{PruneTree}{$Tree, ValData$}
        \State $BestTree \gets Tree$
        \State $BestAcc \gets \text{Check}(BestTree, ValData)$
        \While{\textbf{true}}
            \State $Candidates \gets \text{allPruned}(BestTree)$
            \If{$Candidates$ is empty} \textbf{break} \EndIf

            \State $CandidateBest \gets \text{null}$, $CandAcc \gets -1.0$
            \For{\textbf{each} $C \in Candidates$}
                \State $Acc \gets \text{Check}(C, ValData)$
                \If{$Acc > CandAcc$}
                    \State $CandAcc \gets Acc$
                    \State $CandidateBest \gets C$
                \EndIf
            \EndFor

            \If{$CandAcc \ge BestAcc$}
                \State $BestTree \gets CandidateBest$
                \State $BestAcc \gets CandAcc$
            \Else
                \State \textbf{break} \Comment{Stop if accuracy degrades}
            \EndIf
        \EndWhile
        \State \textbf{return} $BestTree$
    \EndProcedure
    \end{algorithmic}
    \end{algorithm}
    \end{minipage}
    }
