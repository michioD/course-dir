\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Interference Pattern ($N=2^{13}$). Simulation parameters: $dx=0.1, dt=0.01, a=8.0, x_0=-100.0, E=1.0, m=1.0, \hbar  =1.0, t=75.0$, with a potential wall $V_0=100.0$ for $x>0$.}}{1}{figure.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Interference Pattern ($N=2^{14}$). Simulation parameters: $dx=0.1, dt=0.01, a=8.0, x_0=-100.0, E=1.0, m=1.0, \hbar  =1.0, t=75.0$, with a potential wall $V_0=100.0$ for $x>0$.}}{2}{figure.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Wave Packet Splitting at Coulomb Barrier. Simulation parameters: $N=2^{14}, dx=0.1, dt=0.01, a=8.0, x_0=-100.0, E=0.9, m=1.0, \hbar  =1.0, t=110.0$, with Gamow potential $V(x) = 1.0/x$ for $x>1.0$.}}{2}{figure.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Transmission Probability $T$ vs kinetic energy $E\in [0.1,0.9]$. Simulation parameters: $N=2^{14}, dx=0.1, dt=0.01, a=8.0, x_0=-100.0, m=1.0, \hbar  =1.0$, with simulation times $t = 300.0 / \sqrt  {2E}$ and potential $V(x) = 1.0/x$ for $x>1.0$.}}{3}{figure.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Complete Reflection at Flat Potential Step. Simulation parameters: $N=2^{14}, dx=0.1, dt=0.01, a=10.0, x_0=-100.0, E=0.5, m=1.0, \hbar  =1.0, t=110.0$, with a flat step potential $V_0=1.0$ for $x>0$.}}{4}{figure.5}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Fowler-Nordheim Tunneling. Simulation parameters: $N=2^{14}, dx=0.1, dt=0.01, a=10.0, x_0=-100.0, E=0.5, m=1.0, \hbar  =1.0$, with a slanted potential barrier $V(x)=V_0(1-x/4.0)$ for $0 < x < 4.0$ and varying $V_0 \in [0.6, 1.0]$.}}{4}{figure.6}\protected@file@percent }
